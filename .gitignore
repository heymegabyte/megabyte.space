node_modules/
packages/*/dist/
packages/*/.wrangler/
packages/*/wrangler.prod.jsonc
deployment.local.jsonc
.playwright-mcp/
# Loop runtime state — never committed
.claude/run-the-loop/.fire-lease.json
.claude/run-the-loop/.watchdog.lock
.claude/run-the-loop/.watchdog-debt-hash
.claude/run-the-loop/watchdog.log
