{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "vp run -r --cache build",
    "test": "node --test 'scripts/**/*.test.ts' 'scripts/**/*.test.mjs' && vp run --filter '!cloudflare-os-starter' --cache test",
    "test:requirement-evidence": "node --test test/requirement-evidence.test.mjs",
    "verify:requirement-evidence": "node scripts/verify-requirement-evidence.mjs",
    "test:runtime-boundary": "playwright test e2e/runtime-boundary-evidence.spec.ts --config playwright.runtime-boundary.config.ts",
    "verify:runtime-boundary": "pnpm --filter megabyte-home build && pnpm --filter megabyte-home exec wrangler deploy --dry-run --outdir ../../dist-worker && pnpm test:runtime-boundary",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run build",
    "check:interconnect": "node scripts/check-route-reachability.mjs && node scripts/check-dead-components.mjs && node scripts/check-accent-coverage.mjs",
    "check": "node scripts/check-submodule-resolvable.mjs && pnpm run check:interconnect && node scripts/check-scripts-types.mjs && node scripts/deploy.ts --check",
    "deploy": "node scripts/deploy.ts && node scripts/record-deploy.mjs --commit --push"
  },
  "devDependencies": {
    "@theme-tools/shared-utils": "file:vendor/theme-tools/theme-tools-shared-utils-1.0.18.tgz",
    "@theme-tools/testing": "file:vendor/theme-tools/theme-tools-testing-1.0.1-contracts.tgz",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.1.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
