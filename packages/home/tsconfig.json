{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "@cloudflare/workers-types"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "worker.ts", "vite.config.ts"]
}
