{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "megabyte-home",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "84fa0d1b16ff8086dd958c468ce7fd59",
  // workers_dev stays on so the front door always has a fallback origin
  // (and so pre-flight verification can run before the apex swap).
  "workers_dev": true,
  "routes": [{ "pattern": "megabyte.space", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker-first for EVERYTHING except hashed assets: the asset layer serving
    // "/" directly bypassed the worker entirely, so security headers (CSP,
    // Permissions-Policy, …) never reached real browser navigations and the
    // /login 302 regressed once before. Hashed /assets/* stay on the fast path.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ANALYTICS", "class_name": "AnalyticsCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AnalyticsCounter"] }],
  "vars": {
    // Killswitch for the live-analytics surface: "0" ⇒ no capture + /api/analytics/live 404s.
    "ANALYTICS_LIVE": "1"
  },
  "observability": { "enabled": true }
}
